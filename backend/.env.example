# Server
PORT=4000
CLIENT_URL=http://localhost:4200

# MongoDB (baza se popunjava nezavisno preko seed/ + mongoimport, ne iz aplikacije)
MONGO_URI=mongodb://127.0.0.1:27017/printing_house

# JWT
JWT_SECRET=change_this_secret_before_defense
JWT_EXPIRES_IN=2h

# Email (nodemailer). Ako se ne popuni, koristi se automatski Ethereal test nalog
# (mejlovi se ne salju stvarno, ali se generise preview link u konzoli backend-a).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Printing House <no-reply@printinghouse.local>
